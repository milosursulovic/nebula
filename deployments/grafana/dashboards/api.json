{
  "uid": "nebula-api",
  "title": "NEBULA / API",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate by status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(nebula_api_requests_total[1m])) by (status)", "refId": "A", "legendFormat": "{{status}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "p99 request duration by path",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum(rate(nebula_api_request_duration_seconds_bucket[5m])) by (le, path))", "refId": "A", "legendFormat": "{{path}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error rate (5xx)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(rate(nebula_api_requests_total{status=~\"5..\"}[1m]))", "refId": "A", "legendFormat": "5xx" }
      ]
    }
  ]
}
