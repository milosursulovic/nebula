{
  "uid": "nebula-nodes",
  "title": "NEBULA / Nodes",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU usage by node",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "nebula_node_cpu_usage", "refId": "A", "legendFormat": "{{node_id}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory used (MB) by node",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "nebula_node_memory_usage", "refId": "A", "legendFormat": "{{node_id}}" }
      ]
    }
  ]
}
