{
  "uid": "nebula-jobs",
  "title": "NEBULA / Jobs",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Job completions by type/status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(nebula_jobs_total[5m])) by (type, status)", "refId": "A", "legendFormat": "{{type}}/{{status}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Permanent failures by type",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(rate(nebula_jobs_failed_total[5m])) by (type)", "refId": "A", "legendFormat": "{{type}}" }
      ]
    }
  ]
}
